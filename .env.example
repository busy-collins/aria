# ════════════════════════════════════════════════════════
# ARIA — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ════════════════════════════════════════════════════════

# ── AWS ──────────────────────────────────────────────────
AWS_ACCOUNT_ID=your-aws-account-id
DEFAULT_AWS_REGION=us-east-1

# ── Aurora PostgreSQL ─────────────────────────────────────
AURORA_CLUSTER_ARN=arn:aws:rds:us-east-1:ACCOUNT_ID:cluster:aria-aurora-cluster
AURORA_SECRET_ARN=arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:aria-aurora-credentials-XXXXX
DATABASE_NAME=aria

# ── SQS ──────────────────────────────────────────────────
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/aria-research-jobs
SQS_QUEUE_ARN=arn:aws:sqs:us-east-1:ACCOUNT_ID:aria-research-jobs

# ── SageMaker ─────────────────────────────────────────────
SAGEMAKER_ENDPOINT=aria-embedding-endpoint
VECTOR_BUCKET=aria-vectors-ACCOUNT_ID
VECTOR_INDEX_NAME=research-briefs

# ── Researcher App Runner ─────────────────────────────────
RESEARCHER_URL=https://your-app-runner-url.us-east-1.awsapprunner.com

# ── API Gateway ───────────────────────────────────────────
ARIA_API_ENDPOINT=https://your-api-gateway-id.execute-api.us-east-1.amazonaws.com/prod/ingest
ARIA_API_KEY=your-api-key-here

# ── Frontend ──────────────────────────────────────────────
CLOUDFRONT_URL=https://your-distribution-id.cloudfront.net

# ── OpenAI (stored in Secrets Manager in production) ─────
# Set locally for development only
OPENAI_API_KEY=sk-proj-your-key-here

# ── LangSmith ─────────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=ls__your-key-here
LANGSMITH_PROJECT=aria-production

# ── Clerk ─────────────────────────────────────────────────
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json

# ── Frontend (Next.js public vars) ────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-key-here
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/